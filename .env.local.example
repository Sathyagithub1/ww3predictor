# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# News API (https://newsapi.org)
NEWSAPI_KEY=your-newsapi-key-here

# Anthropic / Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Cron job protection — use a random 32-char string
CRON_SECRET=your-random-secret-here

# Google AdSense publisher ID (add once approved)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXX

# WordPress blog URL (e.g. https://blog.ww3predictor.com)
WORDPRESS_BLOG_URL=https://blog.ww3predictor.com

# Your deployed site URL (used for internal API calls during SSR)
NEXT_PUBLIC_SITE_URL=https://ww3predictor.com
